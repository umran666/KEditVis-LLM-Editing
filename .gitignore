# Python virtual environments & bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend dependencies & builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# IDE & Editor files
.qoder/
.vscode/
.idea/
*.swp
*.swo

# Agent workspace memory (local only)
.workbuddy-ai/

# Runtime logs & process tracking
*.log
serve.pid
serve.log
run_log.txt
vite*.log

# Fixture-suite output (regenerated on every run; the committed evidence under
# prototype/audit/ is refreshed deliberately with AUDIT_OUT=../audit)
prototype/audit/run/

# OS-specific files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary extraction files
pdf_extract.txt
pdf_extract_utf8.txt

# External third-party reference clone (contents only; the README that documents
# which revisions to clone is tracked)
prototype/audit/references/*
!prototype/audit/references/README.md
